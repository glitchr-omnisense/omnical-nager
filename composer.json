{
    "name": "omnical/nager",
    "type": "library",
    "description": "Omnical's Nager.Date, under any PHP host, with no key: the public holidays of 200+ countries by subdivision (ISO 3166-2) and type, through API v4 - a provider declared as data (provider.json), loaded by omnisense/omnical's declarative mechanism with no class of its own, its usage policy beside it (commercial use needs a sponsorship of the project).",
    "keywords": [
        "holidays",
        "public-holidays",
        "nager",
        "nager-date",
        "declarative",
        "framework-agnostic",
        "omnical"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnical-nager",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0@dev",
        "omnisense/omnical": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Omnical\\Nager\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnical": {
            "provider": "provider.json"
        },
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
